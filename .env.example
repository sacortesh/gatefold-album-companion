# Everything here is OPTIONAL — the app can be configured entirely from the
# Settings page in the UI, and its runtime config lives in data/app.json.
# Set a value here only to pin it (the matching UI field then shows read-only).
# Handy for docker-compose users who prefer env to clicking through setup.

# Spotify: create an app at https://developer.spotify.com/dashboard and add the
# redirect URI it shows you in Settings. Auth is Authorization Code + PKCE, so
# there is NO client secret.
# SPOTIFY_CLIENT_ID=

# Public base URL the app is reached at (only for remote access — a plain-http
# redirect works for 127.0.0.1, anything else must be https behind a proxy).
# The redirect URI is derived as <PUBLIC_URL>/callback.
# PUBLIC_URL=https://album.example.com

# Override the derived redirect URI outright, if you must.
# SPOTIFY_REDIRECT_URI=

# Discogs: enables the credits half of the "About this album" panel.
# https://www.discogs.com/settings/developers
# DISCOGS_CONSUMER_KEY=
# DISCOGS_CONSUMER_SECRET=

# Dev only — where to send the browser after OAuth (the Vite origin).
WEB_ORIGIN=http://127.0.0.1:5173

# Server bind. HOST=0.0.0.0 to accept connections from other machines —
# every /api/* call still needs the API key (see Settings > Security), but a
# reverse proxy in front is still the right way to add TLS for anything
# beyond your own LAN.
PORT=8888
HOST=127.0.0.1

# Where all mutable state lives (config, reviews, cache, the Spotify token).
# Defaults to ./data. The Docker image sets this to /config and mounts a
# volume there — nothing else needs to change for a fresh, empty volume to
# work: every config file falls back to sane defaults when absent.
# CONFIG_DIR=./data

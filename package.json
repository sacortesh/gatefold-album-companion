{
  "name": "gatefold",
  "version": "0.1.0",
  "private": true,
  "description": "A companion app on top of Spotify for deliberate album listening",
  "license": "AGPL-3.0-only",
  "repository": "github:sacortesh/gatefold-album-companion",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @gatefold/server",
    "dev:web": "npm run dev -w @gatefold/web",
    "build": "npm run build -w @gatefold/web",
    "start": "NODE_ENV=production npm run start -w @gatefold/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}

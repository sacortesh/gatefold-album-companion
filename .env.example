# Copy to .env and fill in from your Spotify app (https://developer.spotify.com/dashboard)
# The redirect URI below must be added verbatim in the dashboard.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Where to send the browser after the OAuth round-trip.
#   dev:  http://127.0.0.1:5173
#   prod: http://127.0.0.1:8888
WEB_ORIGIN=http://127.0.0.1:5173

# Server bind (loopback only — this is the whole security model for MVP1)
PORT=8888
HOST=127.0.0.1

# Optional — enables the "About this album" credits panel (Discogs).
# Register an app at https://www.discogs.com/settings/developers and paste its
# consumer key/secret. Used as read-only API auth; no OAuth flow needed.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
